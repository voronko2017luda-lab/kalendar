          weekday: 'понедельник',
          feast: 'Навечерие Рождества Христова (Рождественский сочельник)',
          text: 'Сочельник — день строгого поста и тихого ожидания. По уставу в этот день вкушают сочиво — постную кашу из пшеницы с мёдом. Вечером совершается всенощное бдение, и Церковь вступает в радость Рождества.',
          element: '<strong>Рецепт:</strong> сочиво из пшеницы, мака, мёда и грецких орехов. <strong>Цитата:</strong> «Сегодня Вифлеем уподобился небу…» (святитель Иоанн Златоуст).'
        }
      ];

      const grid = document.getElementById('calendar-grid');

      function buildCard(dayInfo) {
        const card = document.createElement('div');
        card.className = 'day-card';
        card.setAttribute('role', 'button');
        card.setAttribute('tabindex', '0');
        card.setAttribute('aria-expanded', 'false');

        const monthText = dayInfo.day === 1 || dayInfo.day === 2 || dayInfo.day === 3 || dayInfo.day === 4 || dayInfo.day === 5 || dayInfo.day === 6 ? 'января' : 'декабря';

        card.innerHTML = `
          <div class="day-summary">
            <span class="day-number">${dayInfo.day} ${monthText}</span>
            <span class="day-weekday">${dayInfo.weekday}</span>
            <div class="day-toggle-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </div>
          </div>
          <div class="day-detail">
            <div class="day-detail-inner">
              <div class="day-feast">${dayInfo.feast}</div>
              <p class="day-text">${dayInfo.text}</p>
              <div class="day-element">${dayInfo.element}</div>
            </div>
          </div>
        `;

        function toggle() {
          const isOpen = card.classList.toggle('is-open');
          card.setAttribute('aria-expanded', String(isOpen));
        }

        card.addEventListener('click', toggle);

        card.addEventListener('keydown', function (event) {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            toggle();
          }
        });

        return card;
      }

      days.forEach(function (dayInfo) {
        grid.appendChild(buildCard(dayInfo));
      });
    })();
  </script>

</body>
</html>
