<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Интерактивный православный рождественский календарь на 24 дня.">
  <title>Календарь ожидания — Дорога к Рождеству Христову</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-light: #F8F6F0;
      --bg-blue: #0B306B;
      --bg-blue-dark: #072254;
      --bg-red: #8E2227;
      
      --text-dark: #1F2229;
      --text-light: #FFFFFF;
      --text-muted: #6B6E76;
      
      --card-bg: #FFFFFF;
      --card-hover: #F2EFE6;
      
      --font-display: 'Cormorant Garamond', serif;
      --font-sans: 'Montserrat', sans-serif;
      
      --ease-out: cubic-bezier(0.19, 1, 0.22, 1);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    html { scroll-behavior: smooth; background-color: var(--bg-light); }

    body {
      font-family: var(--font-sans);
      color: var(--text-dark);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; cursor: pointer; }

    /* --- Шапка --- */
    .header {
      position: absolute; top: 0; left: 0; width: 100%;
      padding: 1.5rem 4vw;
      display: flex; justify-content: space-between; align-items: center;
      z-index: 100;
      color: var(--text-light);
    }
    .logo {
      font-family: var(--font-display);
      font-size: 1.4rem; font-weight: 500; letter-spacing: 0.02em;
    }
    .nav { display: flex; gap: 2rem; }
    .nav a {
      font-size: 0.8rem; font-weight: 400; letter-spacing: 0.05em;
      position: relative; padding-bottom: 2px;
      opacity: 0.8; transition: opacity 0.3s;
    }
    .nav a:hover { opacity: 1; }
    .nav a::after {
      content: ''; position: absolute; bottom: 0; left: 0; width: 0; height: 1px;
      background: white; transition: width 0.3s var(--ease-out);
    }
    .nav a:hover::after { width: 100%; }

    /* --- Hero Section --- */
    .hero {
      position: relative;
      background: linear-gradient(135deg, #061533 0%, #164181 50%, #285A9C 100%);
      padding: 120px 4vw 80px;
      text-align: center;
      color: var(--text-light);
      overflow: hidden;
    }
    
    .hero::after {
      content: '';
      position: absolute; bottom: -1px; left: 0; width: 100%; height: 100px;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 1440 100' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0,50 C400,120 1040,-20 1440,50 L1440,100 L0,100 Z' fill='%23F8F6F0'/%3E%3C/svg%3E");
      background-size: 100% 100%;
      z-index: 10;
    }

    .hero-glow {
      position: absolute; top: 10%; left: 50%; transform: translateX(-50%);
      width: 80vw; height: 80vw; max-width: 800px; max-height: 800px;
      background: radial-gradient(circle, rgba(255, 235, 180, 0.15) 0%, transparent 60%);
      border-radius: 50%; z-index: 0; pointer-events: none;
    }

    .hero-content { position: relative; z-index: 2; }
    
    .hero-title {
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 5vw, 4rem);
      line-height: 1.1; font-weight: 500;
      margin-bottom: 1.5rem;
      text-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }
    .hero-subtitle {
      font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.3em;
      color: #E5C886; margin-bottom: 1.5rem;
    }
    .hero-desc {
      font-family: var(--font-display);
      font-size: 1.2rem; line-height: 1.4;
      max-width: 600px; margin: 0 auto;
      color: rgba(255,255,255,0.9);
    }

    /* --- Секция Календаря --- */
    .calendar-section {
      padding: 2rem 4vw 6rem;
      position: relative;
    }

    .calendar-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem;
      max-width: 1300px;
      margin: 0 auto;
    }

    /* Карточка дня */
    .day-card {
      background: var(--card-bg);
      border: 1px solid rgba(11, 48, 107, 0.1);
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
      cursor: pointer;
      transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out), border-color 0.3s;
      overflow: hidden;
      outline: none;
      position: relative;
      display: flex;
      flex-direction: column;
    }

    .day-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 25px rgba(11, 48, 107, 0.08);
      border-color: var(--bg-blue);
    }

    .day-card:focus-visible {
      box-shadow: 0 0 0 3px rgba(11, 48, 107, 0.3);
    }

    .day-card.is-open {
      border-color: var(--bg-blue);
      background: #FCFBF7;
      transform: translateY(0);
      box-shadow: inset 0 0 0 1px var(--bg-blue), 0 10px 30px rgba(11, 48, 107, 0.1);
    }

    .day-summary {
      padding: 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      transition: background 0.3s;
    }

    .day-number {
      font-family: var(--font-display);
      font-size: 1.8rem;
      font-weight: 600;
      color: var(--bg-blue);
      line-height: 1;
    }

    .day-weekday {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--text-muted);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .day-toggle-icon {
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(11, 48, 107, 0.05);
      color: var(--bg-blue);
      transition: transform 0.4s var(--ease-out), background 0.3s;
    }

    .day-card:hover .day-toggle-icon {
      background: var(--bg-blue);
      color: white;
    }

    .day-card.is-open .day-toggle-icon {
      transform: rotate(180deg);
      background: var(--bg-blue);
      color: white;
    }

    /* Раскрывающийся контент */
    .day-detail {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.5s var(--ease-out), opacity 0.3s;
      opacity: 0;
    }

    .day-card.is-open .day-detail {
      max-height: 600px;
      opacity: 1;
    }

    .day-detail-inner {
      padding: 0 1.5rem 1.5rem;
      border-top: 1px solid rgba(11, 48, 107, 0.1);
      margin: 0 1.5rem;
      padding-left: 0;
      padding-right: 0;
      padding-top: 1rem;
    }

    .day-feast {
      font-family: var(--font-display);
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--bg-red);
      margin-bottom: 0.5rem;
      line-height: 1.2;
    }

    .day-text {
      font-size: 0.85rem;
      color: var(--text-dark);
      margin-bottom: 1rem;
      line-height: 1.5;
    }

    .day-element {
      font-size: 0.8rem;
      color: var(--bg-blue-dark);
      background: rgba(11, 48, 107, 0.05);
      padding: 0.8rem 1rem;
      border-radius: 6px;
      border-left: 3px solid var(--bg-blue);
      line-height: 1.4;
    }

    /* --- Подвал --- */
    .footer {
      padding: 3rem 4vw; text-align: center;
      font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em;
      color: var(--text-muted); background: var(--bg-light);
      border-top: 1px solid rgba(11, 48, 107, 0.1);
    }

    /* --- Адаптив --- */
    @media (max-width: 768px) {
      .header { flex-direction: column; gap: 1rem; padding: 1rem 4vw; }
      .nav { flex-wrap: wrap; justify-content: center; gap: 1rem; }
      
      .hero { padding: 140px 4vw 60px; }
      .hero-desc { font-size: 1rem; }
      
      .calendar-grid { grid-template-columns: 1fr; }
      .day-summary { padding: 1.2rem; }
      .day-detail-inner { margin: 0 1.2rem; }
    }
  </style>
</head>
<body>

  <header class="header">
    <a href="index.html" class="logo">Дорога к Рождеству Христову</a>
    <nav class="nav">
      <a href="calendar.html" style="opacity: 1; border-bottom: 1px solid white;">Календарь</a>
      <a href="index.html#sections">Разделы</a>
      <a href="index.html#gallery">Галерея</a>
    </nav>
  </header>

  <main>
    <section class="hero">
